---
import Layout from './Layout.astro';
import '../styles/blog.css';

export interface Props {
  frontmatter: {
    title: string;
    date: string;
    author: string;
    tags: string[];
    image?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout 
  title={`${frontmatter.title} | Blog | Pwnissa`} 
  description={`Articolo di ${frontmatter.author} @ Pwnissa`}
  navbarAutoHide={true}
>
  <Fragment slot="head">
    <meta property="og:type" content="article">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhMATgEsSwCs4smul74iXGOixntILdUW9XmUC6+HX0sLNAK3q71bZlF0160" crossorigin="anonymous">
  </Fragment>
  
  <main class="blog-container">
    <article class="blog-post">
      <header class="post-header">
        <div class="post-meta">
          <div class="article-meta">
            <h1>{frontmatter.title}</h1>
            <div class="meta-info">
              <span class="author">di {frontmatter.author}</span>
              <span class="date">{new Date(frontmatter.date).toLocaleDateString('it-IT')}</span>
              <div class="tags">
                {frontmatter.tags.map(tag => (
                  <span class={`tag ${tag.toLowerCase().replace(/\s+/g, '-')}`}>{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </header>
      <div class="article-content">
        <slot />
      </div>
    </article>
  </main>
</Layout>